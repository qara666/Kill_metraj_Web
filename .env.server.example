# ═══════════════════════════════════════════════════════════════
# Kill Metraj — Конфиг для СЕРВЕРА
# ───────────────────────────────────────────────────────────────
# 1. Скопируй этот файл: cp .env.server.example backend/.env
# 2. Заполни все значения ниже
# 3. Запусти: ./deploy.sh start:prod
# ═══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
NODE_ENV=production
PORT=5001
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────
# Не меняй DB_HOST и DB_PORT — они указывают на Docker контейнер
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kill_metraj
DB_USER=postgres
# ⚠️  ОБЯЗАТЕЛЬНО смени пароль!
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── JWT ───────────────────────────────────────────────────────
# ⚠️  ОБЯЗАТЕЛЬНО смени на случайную строку (32+ символов)!
# Генерация: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING

# ── Admin (создаётся при первом запуске) ─────────────────────
SEED_ADMIN_USERNAME=admin
# ⚠️  Смени пароль после первого входа!
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_ADMIN_EMAIL=admin@your-company.com
SETUP_SECRET=CHANGE_ME_SETUP_SECRET

# ── Внешнее API (Yaposhka dashboard) ─────────────────────────
EXTERNAL_API_URL=http://app.yaposhka.kh.ua:4999/api/v1/dashboard
# ⚠️  Вставь реальный ключ!
EXTERNAL_API_KEY=KMFh23298&23201)8172^&21Vs@gfgsd

# ── Domain (для Caddy HTTPS) ──────────────────────────────────
# Если есть домен — вставь его (Caddy сам получит SSL сертификат)
# Если нет домена — оставь IP адрес сервера (будет HTTP без HTTPS)
DOMAIN=your-server-ip-or-domain.com
FRONTEND_URL=http://your-server-ip-or-domain.com

# ── Redis ─────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_STALE_TTL=600

# ── Routing (OSRM / Valhalla) ─────────────────────────────────
# Удалённые сервисы маршрутизации (работают по умолчанию)
REMOTE_OSRM_URL=http://116.204.153.171:5050
REMOTE_VALHALLA_URL=http://valhalla.yapiko.kh.ua
YAPIKO_OSRM_URL=http://116.204.153.171:5050
AUTO_ROUTE_API_KEY=sn1jJ63Klz6XQMTOnAIIx-_7flQ4cJ4bVF9v9KqgYBQ

# ── Cache ─────────────────────────────────────────────────────
CACHE_MAX_ENTRIES=20
CACHE_MAX_SIZE_MB=8

# ── DB Sync (не менять в production!) ────────────────────────
DB_ALTER_SYNC=false

# ── gRPC ─────────────────────────────────────────────────────
GRPC_PORT=50051
